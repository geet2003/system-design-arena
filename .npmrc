# Required for NestJS to resolve its internal peer deps in a pnpm workspace.
# NestJS uses a flat node_modules pattern that pnpm's strict isolation breaks.
shamefully-hoist=true
public-hoist-pattern[]=@prisma/*

# Ensure pnpm respects the packageManager field
manage-package-manager-versions=true

# Prevent accidental publishing of private packages
strict-peer-dependencies=false

# Suppress warnings for missing peer deps we can't control
auto-install-peers=true
